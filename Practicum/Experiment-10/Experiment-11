import java.util.Hashtable;
import java.util.Map;
import java.util.Scanner;

public class BookLookupSystem {
    public static void main(String[] args) {
        Hashtable<Integer, String> books = new Hashtable<>();
        Scanner sc = new Scanner(System.in);

        while (true) {
            System.out.println("\n1. Add Book\n2. Search Book\n3. Remove Book\n4. Display All Books\n5. Exit");
            System.out.print("Enter choice: ");
            int choice = sc.nextInt();

            if (choice == 1) {
                System.out.print("Enter Book ID: ");
                int id = sc.nextInt();
                sc.nextLine(); // clear buffer
                System.out.print("Enter Book Title: ");
                String title = sc.nextLine();
                books.put(id, title);
                System.out.println("Book added successfully.");

            } else if (choice == 2) {
                System.out.print("Enter Book ID to search: ");
                int id = sc.nextInt();
                if (books.containsKey(id)) {
                    System.out.println("Book Found -> ID: " + id + ", Title: " + books.get(id));
                } else {
                    System.out.println("Book not found.");
                }

            } else if (choice == 3) {
                System.out.print("Enter Book ID to remove: ");
                int id = sc.nextInt();
                if (books.containsKey(id)) {
                    books.remove(id);
                    System.out.println("Book removed successfully.");
                } else {
                    System.out.println("Book not found. Unable to remove.");
                }

            } else if (choice == 4) {
                if (books.isEmpty()) {
                    System.out.println("No books available in the library.");
                } else {
                    for (Map.Entry<Integer, String> entry : books.entrySet()) {
                        System.out.println("ID: " + entry.getKey() + " | Title: " + entry.getValue());
                    }
                }

            } else if (choice == 5) {
                System.out.println("Exiting Book Lookup System.");
                break;

            } else {
                System.out.println("Invalid choice. Please select a valid option.");
            }
        }
        sc.close();
    }
}
